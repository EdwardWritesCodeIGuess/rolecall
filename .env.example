# Copy to .env and fill in. Everything optional is marked; the app runs with just the first block.

# --- Dashboard ---------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long
# Encrypts stored platform tokens. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(40))"
SECRET_KEY=
# Where you open the dashboard. Also the OAuth redirect base for YouTube.
BASE_URL=http://localhost:8080
TZ=America/New_York

# --- Public HTTPS URL (needed for Instagram + streamer sign-up pages) ---------
# Tailscale Funnel (https://<host>.<tailnet>.ts.net) or a Cloudflare Tunnel hostname.
PUBLIC_BASE_URL=
CLOUDFLARE_TUNNEL_TOKEN=
# Shown on /p/privacy and /p/terms (optional)
CONTACT_EMAIL=

# --- Brand ---------------------------------------------------------------------
BRAND_NAME=Rolecall
BRAND_HANDLE=rolecallclips

# --- YouTube (Google Cloud OAuth client, "Web application") -------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Instagram (Meta app with "Instagram API with Instagram login") ------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
IG_API_VERSION=v24.0

# --- TikTok (optional: only for inbox/draft mode) -------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Optional, costs money: sharper titles + LLM moment reranking ---------------
# Leave empty to use the free rule-based writer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Optional alerts (Discord webhook URL, Slack webhook, or https://ntfy.sh/<topic>) ---
# n8n's alert workflows use it too (review needed, ready to post by hand, failures, daily report).
NOTIFY_WEBHOOK=

# --- n8n automation (docs/N8N.md) ----------------------------------------------
# Shared by Rolecall's /api/v1 and n8n. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ROLECALL_API_TOKEN=
# Where Rolecall sends events. Docker compose overrides this to http://n8n:5678/webhook/rolecall-events
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/rolecall-events

# --- Tuning ---------------------------------------------------------------------
# small.en is more accurate but ~3x slower
WHISPER_MODEL=base.en
# USD per render-hour (electricity), used for cost-per-clip
COMPUTE_COST_PER_HOUR=0.05
WORKER_INTERVAL=20
