    {
      "parameters": {
        "jsCode": "\nfunction forChannel(text) {\n  const url = ($env.NOTIFY_WEBHOOK_URL || '').trim();\n  let payload = text, contentType = 'text/plain';\n  if (url.includes('discord.com/api/webhooks') || url.includes('discordapp.com/api/webhooks')) {\n    payload = JSON.stringify({ content: text.slice(0, 1900), allowed_mentions: { parse: [] } });\n    contentType = 'application/json';\n  } else if (url.includes('hooks.slack.com')) {\n    payload = JSON.stringify({ text });\n    contentType = 'application/json';\n  }\n  return { json: { url, contentType, payload, text } };\n}\n\nconst r = $('Yesterday in numbers').first().json;\nconst t = $('Where we post').first().json;\nconst plats = (t.platforms || []).filter(p => p.enabled)\n  .map(p => `${p.platform} (${p.mode === 'api' ? 'auto' : 'by hand'}${p.connected ? '' : ', NOT connected'})`).join(', ');\nconst by = Object.entries(r.published_by_platform || {}).map(([k, v]) => `${k} ${v}`).join(', ') || 'none';\nconst top = (r.top || []).map(x => `• ${x.title} — ${x.views} views (${x.platform})`).join('\\n');\nconst money = (v) => v == null ? '-' : `$${Number(v).toFixed(2)}`;\nconst lines = [\n  `[Rolecall] Daily report${r.paused ? ' (PAUSED)' : ''}`,\n  `New VODs: ${r.sources_ingested} · clips made: ${r.clips_made} · posted: ${r.published} (${by})`,\n  `Waiting on you: ${r.needs_review} to review, ${r.export_ready} to post by hand, ${r.failed} failed`,\n  `Followers: ${Object.entries(r.followers || {}).map(([k, v]) => `${k} ${v}`).join(', ') || '-'} · total views ${r.views_total}`,\n  `This month: revenue ${money(r.revenue_month)}, cost ${money(r.cost_month)}, cost/clip ${money(r.cost_per_clip)} · new leads ${r.leads_new}, clients ${r.clients}`,\n  `Posting to: ${plats || 'nothing enabled'} as @${t.handle} · driver: ${r.driver}`,\n];\nif (top) lines.push('Top clips:\\n' + top);\nlines.push(`Dashboard: ${r.dashboard}`);\nreturn [forChannel(lines.join('\\n'))];\n"
      },
